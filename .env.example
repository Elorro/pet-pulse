# Environment
ENVIRONMENT=development

# Database (Supabase: usar el "Session pooler", puerto 5432, con esquema asyncpg)
DATABASE_URL_ASYNC=postgresql+asyncpg://postgres:postgres@localhost:5432/social_network

# Supabase Auth. El backend solo verifica tokens; no los emite.
SUPABASE_URL=https://<project-ref>.supabase.co
# Clave pública del proyecto (anon / publishable). Dashboard > Project Settings > API Keys.
SUPABASE_ANON_KEY=
# Destino de verificación de correo en producción (debe ser HTTPS y estar
# permitido en Supabase Auth > URL Configuration > Redirect URLs).
# En desarrollo local puede omitirse para usar el Site URL local de Supabase.
AUTH_EMAIL_REDIRECT_TO=https://petpulseweb.vercel.app
# Clave privada server-only para firmar cargas de Storage. Nunca exponer al navegador.
SUPABASE_SERVICE_ROLE_KEY=
# Bucket público server-only utilizado para imágenes de publicaciones.
SUPABASE_MEDIA_BUCKET=post-media
# Solo necesario en proyectos legados que firman con HS256.
# SUPABASE_JWT_SECRET=
