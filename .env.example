# Environment
ENVIRONMENT=development

# Database (Supabase: usar el "Session pooler", puerto 5432, con esquema asyncpg)
DATABASE_URL_ASYNC=postgresql+asyncpg://postgres:postgres@localhost:5432/social_network

# Supabase Auth. El backend solo verifica tokens; no los emite.
SUPABASE_URL=https://<project-ref>.supabase.co
# Solo necesario en proyectos legados que firman con HS256.
# SUPABASE_JWT_SECRET=
