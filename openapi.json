  "components": {
    "schemas": {
      "CommentAuthorResponse": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "username": {
            "type": "string",
            "title": "Username"
          }
        },
        "type": "object",
        "required": [
          "id",
          "username"
        ],
        "title": "CommentAuthorResponse"
      },
      "CommentCreate": {
        "properties": {
          "content": {
            "type": "string",
            "maxLength": 5000,
            "minLength": 1,
            "title": "Content"
          },
          "media_path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Media Path",
            "description": "Ruta devuelta por POST /api/v1/posts/comment-media-uploads; debe pertenecer al usuario autenticado y estar cargada."
          }
        },
        "type": "object",
        "required": [
          "content"
        ],
        "title": "CommentCreate"
      },
      "CommentMediaUploadCreate": {
        "properties": {
          "content_type": {
            "type": "string",
            "enum": [
              "image/jpeg",
              "image/png",
              "image/webp",
              "image/gif"
            ],
            "title": "Content Type"
          },
          "file_size_bytes": {
            "type": "integer",
            "maximum": 5242880.0,
            "exclusiveMinimum": 0.0,
            "title": "File Size Bytes"
          }
        },
        "type": "object",
        "required": [
          "content_type",
          "file_size_bytes"
        ],
        "title": "CommentMediaUploadCreate",
        "description": "Solicitud firmada; file_size_bytes sirve para rechazar archivos grandes antes de subir."
      },
      "CommentResponse": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "post_id": {
            "type": "string",
            "format": "uuid",
            "title": "Post Id"
          },
          "content": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Content"
          },
          "media_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Media Url",
            "description": "URL pública renderizable del adjunto; null para comentarios solo de texto."
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "author": {
            "$ref": "#/components/schemas/CommentAuthorResponse"
          }
        },
        "type": "object",
        "required": [
          "id",
          "post_id",
          "content",
          "media_url",
          "created_at",
          "author"
        ],
        "title": "CommentResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LikeResponse": {
        "properties": {
          "post_id": {
            "type": "string",
            "format": "uuid",
            "title": "Post Id"
          },
          "like_count": {
            "type": "integer",
            "title": "Like Count"
          },
          "liked": {
            "type": "boolean",
            "title": "Liked",
            "default": true
          }
        },
        "type": "object",
        "required": [
          "post_id",
          "like_count"
        ],
        "title": "LikeResponse"
      },
      "LoginRequest": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "LoginRequest"
      },
      "MediaUploadCreate": {
        "properties": {
          "content_type": {
            "type": "string",
            "enum": [
              "image/jpeg",
              "image/png",
              "image/webp",
              "image/gif"
            ],
            "title": "Content Type"
          }
        },
        "type": "object",
        "required": [
          "content_type"
        ],
        "title": "MediaUploadCreate",
        "description": "Solicitud de URL firmada para subir una imagen."
      },
      "MediaUploadResponse": {
        "properties": {
          "path": {
            "type": "string",
            "title": "Path"
          },
          "upload_url": {
            "type": "string",
            "title": "Upload Url"
          }
        },
        "type": "object",
        "required": [
          "path",
          "upload_url"
        ],
        "title": "MediaUploadResponse",
        "description": "Ruta de almacenamiento y URL temporal para la carga directa."
      },
      "PostCreate": {
        "properties": {
          "content": {
            "type": "string",
            "maxLength": 5000,
            "minLength": 1,
            "title": "Content"
          },
          "media_path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Media Path"
          }
        },
        "type": "object",
        "required": [
          "content"
        ],
        "title": "PostCreate",
        "description": "Esquema de entrada para crear una publicación."
      },
      "PostResponse": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "author_id": {
            "type": "string",
            "format": "uuid",
            "title": "Author Id"
          },
          "content": {
            "type": "string",
            "title": "Content"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          },
          "media_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Media Url"
          },
          "like_count": {
            "type": "integer",
            "title": "Like Count",
            "default": 0
          }
        },
        "type": "object",
        "required": [
          "id",
          "author_id",
          "content",
          "created_at",
          "updated_at",
          "media_url"
        ],
        "title": "PostResponse",
        "description": "Esquema de salida para una publicación del foro."
      },
      "ProfileResponse": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "username": {
            "type": "string",
            "title": "Username"
          },
          "full_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Full Name"
          },
          "photo_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Photo Url"
          },
          "email": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Email"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
