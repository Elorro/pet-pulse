    "/api/v1/posts/comment-media-uploads": {
      "post": {
        "tags": [
          "posts"
        ],
        "summary": "Solicitar URL de carga para adjunto de comentario",
        "description": "Acepta JPEG, PNG, WebP o GIF de hasta 5 MiB. La API vuelve a verificar tipo y tamaño del objeto al crear el comentario.",
        "operationId": "create_comment_media_upload_api_v1_posts_comment_media_uploads_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CommentMediaUploadCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MediaUploadResponse"
                }
              }
            }
          },
          "401": {
            "description": "Falta un token de autenticación válido"
          },
          "422": {
            "description": "Tipo o tamaño no válido"
          },
          "502": {
            "description": "No se pudo preparar la carga"
          },
          "503": {
            "description": "Almacenamiento no configurado"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/v1/posts/": {
      "get": {
        "tags": [
          "posts"
